Windows Registry Editor Version 5.00

; how to export registry settings
; REG export HKCU\Control Panel\Accessibility %userprofile%\desktop\SettingsA.reg /y

; The hex data is in five groups of four bytes:
;   00,00,00,00,\    header version (always 00000000)
;   00,00,00,00,\    header flags (always 00000000)
;   04,00,00,00,\    # of entries (3 in this case) plus a NULL terminator line.
;                    Entries are in 2-byte pairs: Key code to send & keyboard key to send it.
;                    Each entry is in "least significant byte, most significant byte" order,
;                    e.g. 0x1234 becomes `34,12`
;   1d,00,3a,00,\    Send LEFT CTRL (0x001d) code when user presses the CAPS LOCK key (0x003a) 
;   38,00,1d,00,\    Send LEFT ALT (0x0038) code when user presses the LEFT CTRL key (0x001d) 
;   3a,00,38,00,\    Send CAPS LOCK (0x003a) code when user presses the LEFT ALT key (0x0038) 
;   00,00,00,00      NULL terminator
; https://developer.mozilla.org/en-US/docs/Web/API/UI_Events/Keyboard_event_code_values
; Send SEMICOLON 0027 when pressing TAB   000f
; Send TAB 000f       when pressing RCTRL e01d
; Send LCTRL 001d     when pressing CAPSL 003a
; Send RCTRL e01d     when pressing SEMICOLON 0027
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\Keyboard Layout]
"Scancode Map"=hex:00,00,00,00,\
                   00,00,00,00,\
                   05,00,00,00,\
                   27,00,0f,00,\
                   0f,00,1d,e0,\
                   1d,00,3a,00,\
                   1d,e0,27,00,\
                   00,00,00,00

; set windows time to utc
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\TimeZoneInformation]
"RealTimeIsUniversal"=dword:00000001

; enable utf-8 for world wide language support

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\Nls\CodePage]
"ACP"="65001"
"OEMCP"="65001"
"MACCP"="65001"

; configure automatic updates to disabled
; i will do bi-monthly updates myself
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows\WindowsUpdate\AU]
"NoAutoUpdate"=dword:00000001

; touchpad: three finger tap for middle button, slide for desktop switch
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\PrecisionTouchPad]
"AAPThreshold"=dword:00000002
"CursorSpeed"=dword:0000000a
"EnableEdgy"=dword:00000001
"LeaveOnWithMouse"=dword:00000001
"PanEnabled"=dword:00000001
"RightClickZoneEnabled"=dword:00000001
"ScrollDirection"=dword:00000000
"TapAndDrag"=dword:00000001
"TapsEnabled"=dword:00000001
"TwoFingerTapEnabled"=dword:00000001
"ZoomEnabled"=dword:00000001
"ThreeFingerTapEnabled"=dword:00000004
"ThreeFingerSlideEnabled"=dword:00000002
"FourFingerSlideEnabled"=dword:00000000
"FourFingerTapEnabled"=dword:00000000

; disable windows 11 context menu
; restore old windows 10 context menu
[HKEY_CURRENT_USER\Software\Classes\CLSID\{86ca1aa0-34aa-4e8b-a509-50c905bae2a2}\InprocServer32]
@=""

; enable mouse hover, but do not bring window to the top
; the latter is for pop-up windows to function
[HKEY_CURRENT_USER\Control Panel\Desktop]
"UserPreferencesMask"=hex:91,12,03,80,10,00,00,00
"ActiveWndTrkTimeout"=dword:00000064

; enable long path
; https://learn.microsoft.com/en-us/windows/win32/fileio/maximum-file-path-limitation
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\FileSystem]
"LongPathsEnabled"=dword:00000001
